# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Providers (add only what you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Local / self-hosted, e.g. Ollama or vLLM
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_API_KEY=

# --- Default models per provider ---
# Heterogeneity is the most consistently supported intervention in the corpus
# (2502.08788 calls it a "universal antidote"), so cross-provider runs matter.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=
GEMINI_MODEL=
LOCAL_MODEL=

# --- Run settings ---
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=2048

# Hard ceiling per experiment. Cost is a primary metric here (2605.00914 found
# debate at 2.1-3.4x the tokens of self-correction), so cap runs deliberately.
MAX_TOKENS_PER_EXPERIMENT=1000000

# Directory for trajectory logs (gitignored)
RESULTS_DIR=./runs
